{
  "name": "EKS Foundations",

  // Base image is pinned to a specific Ubuntu tag. For maximum long-term
  // reproducibility, replace the tag with a sha256 digest.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Tools are installed and pinned declaratively, so every student gets the
  // identical toolchain regardless of host OS.
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.15.8",
      "tflint": "none",
      "terragrunt": "none"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "2.36.4"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.36.2",
      "helm": "none",
      "minikube": "none"
    }
  },

  // Default region for the whole course. This is the one place the region is set
  // for the container: change this value to work in a different region.
  "containerEnv": {
    "AWS_REGION": "us-east-1"
  },

  // Persist AWS credentials and kubeconfig across container rebuilds using named
  // volumes. Named volumes carry no host path, so this behaves identically on
  // Windows, macOS, and Linux. Credentials never live in the image.
  "mounts": [
    "source=eks-foundations-aws,target=/home/vscode/.aws,type=volume",
    "source=eks-foundations-kube,target=/home/vscode/.kube,type=volume"
  ],

  // Runs once on create: fixes volume ownership, applies the Oh My Zsh look
  // (robbyrussell theme, git and aws plugins, syntax highlighting), wires up
  // shell completion for terraform, kubectl, and aws (bash and zsh), and prints
  // the tool versions.
  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      // Open zsh, not bash, as the default integrated terminal.
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "hashicorp.terraform",
        "amazonwebservices.aws-toolkit-vscode"
      ]
    }
  }
}
